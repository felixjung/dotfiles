{
  "defaultModel": {{ if eq .machine_type "work" }}"gpt-6-sol"{{ else }}"gpt-6.1-sol"{{ end }},
  "defaultProvider": {{ if eq .machine_type "work" }}"github-copilot"{{ else }}"openai"{{ end }},
  "defaultThinkingLevel": "high",
  "enabledModels": [
{{- if eq .machine_type "work" }}
    "github-copilot/claude-opus-5.5",
    "github-copilot/claude-sonnet-5",
    "github-copilot/gpt-6-astra",
    "github-copilot/gpt-6-sol",
    "github-copilot/gpt-6-luna",
    "cursor/claude-opus-5-5@300k",
    "cursor/claude-sonnet-5@1m",
    "cursor/gpt-5.6-sol@1m",
    "cursor/gpt-5.6-luna@1m",
    "cursor/composer-2.5",
    "cursor/auto-smart"
{{- else }}
    "openai/gpt-6-luna",
    "openai/gpt-6.1-sol",
    "openai/gpt-6-astra"
{{- end }}
  ],
  "modelThinkingLevels": {
    "github-copilot/claude-sonnet-5": "xhigh"
  },
  "memory": {
    "lessonInjection": "selective",
    "consolidationModel": {{ if eq .machine_type "work" }}"github-copilot/gpt-6-luna"{{ else }}"openai/gpt-6-luna"{{ end }}
  },
  "subagents": {
    "defaultThinking": "medium",
    "asyncByDefault": true,
    "fleetView": true,
    "agentOverrides": {
      "scout": {
        "thinking": "low"
      },
      "researcher": {
        "thinking": "medium"
      },
      "evidence-auditor": {
        "thinking": "xhigh"
      },
      "worker": {
        "thinking": "medium"
      },
      "reviewer": {
        "thinking": "high"
      },
      "oracle": {
        "thinking": "xhigh"
      }
    },
    "agentOverridesByProvider": {
      "github-copilot": {
        "scout": {
          "model": "github-copilot/gpt-6-luna"
        },
        "researcher": {
          "model": "github-copilot/gpt-6-luna"
        },
        "evidence-auditor": {
          "model": "github-copilot/claude-sonnet-5"
        },
        "worker": {
          "model": "github-copilot/gpt-6-sol"
        },
        "reviewer": {
          "model": "github-copilot/gpt-6-sol"
        },
        "oracle": {
          "model": "github-copilot/gpt-6-astra"
        }
      },
      "cursor": {
        "scout": {
          "model": "cursor/gpt-5.6-luna@1m"
        },
        "researcher": {
          "model": "cursor/gpt-5.6-luna@1m"
        },
        "evidence-auditor": {
          "model": "cursor/claude-sonnet-5@1m"
        },
        "worker": {
          "model": "cursor/gpt-5.6-sol@1m"
        },
        "reviewer": {
          "model": "cursor/gpt-5.6-sol@1m"
        },
        "oracle": {
          "model": "cursor/claude-opus-5-5@300k"
        }
      },
      "openai": {
        "scout": {
          "model": "openai/gpt-6-luna"
        },
        "researcher": {
          "model": "openai/gpt-6-luna"
        },
        "evidence-auditor": {
          "model": "openai/gpt-6-astra"
        },
        "worker": {
          "model": "openai/gpt-6.1-sol"
        },
        "reviewer": {
          "model": "openai/gpt-6.1-sol"
        },
        "oracle": {
          "model": "openai/gpt-6-astra"
        }
      }
    }
  },
  "lastChangelogVersion": "0.99.1",
  "packages": [
    "npm:context-mode",
    "npm:pi-autoresearch",
{{- if eq .machine_type "work" }}
    "npm:pi-cursor-sdk",
{{- end }}
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-total-recall",
    "npm:@juicesharp/rpiv-voice",
    "npm:@firstpick/pi-themes-bundle",
    "npm:pi-web-access",
    "npm:@plannotator/pi-extension"
  ],
  "quietStartup": true,
  "theme": "catppuccin-latte/catppuccin-mocha",
  "steeringMode": "all",
  "hideThinkingBlock": true,
  "enableInstallTelemetry": false,
  "treeFilterMode": "no-tools"
}
