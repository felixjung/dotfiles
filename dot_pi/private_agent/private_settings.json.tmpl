{
  "defaultModel": {{ if eq .machine_type "work" }}"claude-sonnet-5-5@300k"{{ else }}"gpt-6.1-sol"{{ end }},
  "defaultProvider": {{ if eq .machine_type "work" }}"cursor"{{ else }}"openai"{{ end }},
  "defaultThinkingLevel": {{ if eq .machine_type "work" }}"medium"{{ else }}"high"{{ end }},
  "defaultTools": [
    "+codemode"
  ],
  "enabledModels": [
{{- if eq .machine_type "work" }}
    "ollama/gemma4:12b-mlx",
    "ollama/qwen3.6:35b-mlx",
    "ollama/qwen3.8:27b-mlx",
    "ollama/qwen3-coder:30b",
    "github-copilot/claude-opus-5.5",
    "github-copilot/claude-sonnet-5.5",
    "github-copilot/gpt-6-astra",
    "github-copilot/gpt-6.1-sol",
    "github-copilot/gpt-6-luna",
    "cursor/claude-fable-5@1m",
    "cursor/claude-opus-5-5@300k",
    "cursor/claude-sonnet-5-5@300k",
    "cursor/claude-haiku-5-5@300k",
    "cursor/gpt-5.6-sol@1m",
    "cursor/composer-2.5",
    "cursor/auto-smart"
{{- else }}
    "openai/gpt-6-luna",
    "openai/gpt-6.1-sol",
    "openai/gpt-6-astra",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-astra"
{{- end }}
  ],
  "modelThinkingLevels": {
    "github-copilot/claude-sonnet-5.5": {{ if eq .machine_type "work" }}"medium"{{ else }}"xhigh"{{ end }}
  },
  "memory": {
    "lessonInjection": "selective",
    "consolidationModel": {{ if eq .machine_type "work" }}"github-copilot/gpt-6-luna"{{ else }}"openai/gpt-6-luna"{{ end }}
  },
  "subagents": {
    "defaultThinking": "medium",
    "asyncByDefault": true,
    "fleetView": true,
    "agentOverrides": {
      "scout": {
        "thinking": "low"
      },
      "researcher": {
        "thinking": "medium"
      },
      "evidence-auditor": {
        "thinking": "xhigh"
      },
      "worker": {
        "thinking": "medium"
      },
      "reviewer": {
        "thinking": "high"
      },
      "oracle": {
        "thinking": "xhigh"
      }
    },
    "agentOverridesByProvider": {
{{- if eq .machine_type "work" }}
      "ollama": {
        "scout": {
          "model": "inherit",
          "thinking": "off"
        },
        "researcher": {
          "model": "inherit",
          "thinking": "off"
        },
        "evidence-auditor": {
          "model": "inherit",
          "thinking": "high"
        },
        "worker": {
          "model": "inherit",
          "thinking": "medium"
        },
        "reviewer": {
          "model": "inherit",
          "thinking": "high"
        },
        "oracle": {
          "model": "inherit",
          "thinking": "high"
        }
      },
{{- end }}
      "github-copilot": {
        "scout": {
          "model": "github-copilot/gpt-6-luna"
        },
        "researcher": {
          "model": "github-copilot/gpt-6-luna"
        },
        "evidence-auditor": {
          "model": "github-copilot/claude-sonnet-5.5"{{ if eq .machine_type "work" }},
          "thinking": "medium"{{ end }}
        },
        "worker": {
          "model": "github-copilot/gpt-6.1-sol"
        },
        "reviewer": {
          "model": "github-copilot/gpt-6.1-sol"
        },
        "oracle": {
          "model": "github-copilot/gpt-6-astra"{{ if eq .machine_type "work" }},
          "thinking": "high"{{ end }}
        }
      },
      "cursor": {
        "scout": {
          "model": "cursor/claude-haiku-5-5@300k"
        },
        "researcher": {
          "model": {{ if eq .machine_type "work" }}"cursor/claude-haiku-5-5@300k"{{ else }}"cursor/claude-sonnet-5-5@300k"{{ end }}
        },
        "evidence-auditor": {
          "model": "cursor/claude-sonnet-5-5@300k"{{ if eq .machine_type "work" }},
          "thinking": "medium"{{ end }}
        },
        "worker": {
          "model": "cursor/claude-sonnet-5-5@300k"
        },
        "reviewer": {
          "model": {{ if eq .machine_type "work" }}"cursor/claude-sonnet-5-5@300k"{{ else }}"cursor/claude-opus-5-5@300k"{{ end }}
        },
        "oracle": {
          "model": "cursor/claude-opus-5-5@300k"{{ if eq .machine_type "work" }},
          "thinking": "high"{{ end }}
        }
      },
      "openai": {
        "scout": {
          "model": "openai/gpt-6-luna"
        },
        "researcher": {
          "model": "openai/gpt-6-luna"
        },
        "evidence-auditor": {
          "model": "openai/gpt-6-astra"
        },
        "worker": {
          "model": "openai/gpt-6.1-sol"
        },
        "reviewer": {
          "model": "openai/gpt-6.1-sol"
        },
        "oracle": {
          "model": "openai/gpt-6-astra"
        }
      },
      "openai-codex": {
        "scout": {
          "model": "openai-codex/gpt-6-luna"
        },
        "researcher": {
          "model": "openai-codex/gpt-6-luna"
        },
        "evidence-auditor": {
          "model": "openai-codex/gpt-6-astra"
        },
        "worker": {
          "model": "openai-codex/gpt-6.1-sol"
        },
        "reviewer": {
          "model": "openai-codex/gpt-6.1-sol"
        },
        "oracle": {
          "model": "openai-codex/gpt-6-astra"
        }
      }
    }
  },
  "lastChangelogVersion": "1.4.0",
  "packages": [
    "npm:pi-autoresearch",
{{- if eq .machine_type "work" }}
    "npm:pi-cursor-sdk",
{{- end }}
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-total-recall",
    "npm:@juicesharp/rpiv-voice",
    "npm:pi-web-access",
    "npm:@plannotator/pi-extension",
    "git:github.com/obra/superpowers@v6.4.2"
  ],
  "quietStartup": true,
  "steeringMode": "all",
  "hideThinkingBlock": true,
  "enableInstallTelemetry": false,
  "treeFilterMode": "no-tools"
}
