[include]
    path = ~/.config/git/delta/catppuccin.gitconfig
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
[credential "ssh://git@github.com/"]
	helper = /usr/bin/env gh auth git-credential
[credential "https://github.com"]
	helper = /usr/bin/env gh auth git-credential
[credential "https://gist.github.com"]
	helper = /usr/bin/env gh auth git-credential
[user]
	email = {{ .email | quote }}
	name = {{ .full_name | quote }}
{{- if and (hasKey . "signing_key") .signing_key }}
	signingkey = {{ .signing_key }}
[gpg]
	format = ssh
{{- if eq .chezmoi.os "darwin" }}
[gpg "ssh"]
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
{{- end }}
[commit]
	gpgsign = true
{{- end }}
[push]
	default = simple
[interactive]
	diffFilter = delta --color-only
[mergetool]
	keepBackup = true
[filter "media"]
	clean = git-media-clean %f
	smudge = git-media-smudge %f
[alias]
	latest-commits = log -5 --pretty --oneline
	list-branches = for-each-ref --count=30 --sort=-committerdate refs/heads/ --format='%(refname:short)'
	tree = log --all --graph --decorate --oneline --simplify-by-decoration
	stats = shortlog -sn
	sync = remote update --prune
[tig "color"]
	cursor = color15 red bold
	title-blur = color0 color5
	title-focus = color0 color5 bold
[core]
	pager = delta
	editor = nvim
[pull]
  ff = true
[delta]
	features = catppuccin-macchiato
	navigate = true
	line-numbers = true
# Runtime theme override, written by update_theme in
# dot_config/fish/conf.d/auto_theme.fish when macOS flips light/dark. Git
# expands includes in place, so this wins over the default above. The file
# is deliberately unmanaged and may not exist; git ignores missing includes.
[include]
	path = ~/.config/git/delta/current-theme.gitconfig
[merge]
    conflictstyle = zdiff3
