{{ if eq .machine_type "work" -}}
set -gx SUMUP_GITHUB_NPM_REGISTRY "op://SumUp/NPM Registry GitHub Personal Access Token/token"
set -gx NPM_ACCESS_TOKEN "op://SumUp/npm Access Token/token"
{{ else -}}
set -gx NPM_ACCESS_TOKEN "op://Private/GitHub PAT/token"
{{ end -}}

# Make npm read the chezmoi-managed npmrc (sets the global prefix to ~/.local,
# independent of the asdf node version and Homebrew's node). Without this npm
# falls back to ~/.npmrc and Homebrew node's builtin prefix=/opt/homebrew.
set -gx NPM_CONFIG_USERCONFIG "$HOME/.config/npm/npmrc"

alias npm="op run -- npm"

# pnpm
set -gx PNPM_HOME "$HOME/Library/pnpm"
if not contains -- "$PNPM_HOME" $PATH
    fish_add_path "$PNPM_HOME"
end
# pnpm end
