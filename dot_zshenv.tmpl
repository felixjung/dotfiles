# If you come from bash you might have to change your $PATH.

{{ $brew_prefix := "" -}}

{{ if eq .chezmoi.os "linux" -}}
	{{ $brew_prefix = "/home/linuxbrew/.linuxbrew" -}}
{{ else -}}
	{{ $brew_prefix = "/opt/homebrew" -}}
{{ end -}}

export XDG_CONFIG_HOME="$HOME/.config"
export PATH=$HOME/.cargo/bin:{{ $brew_prefix }}/opt/rustup/bin:{{ $brew_prefix }}/bin:$HOME/.local/bin:$PATH
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# Shims also resolve project tools in noninteractive shells.
export PATH="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims:$HOME/.local/share/go/bin:$PATH"
