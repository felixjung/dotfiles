{{ $email := promptString "email" -}}
{{ $full_name := promptString "Full name" -}}
{{ $dev_folder := promptString "Dev Folder" -}}
{{ $machine_type := promptString "Machine Type (work/personal)" -}}
{{ $signing_key := promptStringOnce . "signing_key" "SSH signing key for commit signing (blank to disable)" -}}

git:
    autoPush: false
    autoCommit: false
data:
    email: {{ $email | quote }}
    full_name: {{ $full_name | quote }}
    dev_folder: {{ $dev_folder | quote }}
    machine_type: {{ $machine_type | quote }}
    signing_key: {{ $signing_key | quote }}

# Externals are upstream dependencies: keep them out of the per-file output of
# these commands. `apply` has no such setting; use `cma` (--exclude=externals).
status:
    exclude: ["externals"]
diff:
    exclude: ["externals"]
verify:
    exclude: ["externals"]
