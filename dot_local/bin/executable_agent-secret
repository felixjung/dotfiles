#!/bin/sh
# agent-secret: print a secret from 1Password, read as the agents' service
# account.
#
# The service account token lives in the login Keychain (service
# "op-agent-token") and is only passed to this one `op read`; exporting it
# would make `op run` elsewhere sign in as the service account too. Works while
# the 1Password app is locked.
#
# sbx runs this for the sandboxes' secrets (see the sbx setup script), so it
# must stay outside every sandbox mount.
#
# example usage:
#   agent-secret "op://Agents/GitHub Agent PAT/token"
set -eu

if [ $# -ne 1 ]; then
    echo "usage: agent-secret op://<vault>/<item>/<field>" >&2
    exit 2
fi

token=$(/usr/bin/security find-generic-password -s op-agent-token -w 2>/dev/null) || {
    echo "agent-secret: no 'op-agent-token' item in the login Keychain" >&2
    exit 1
}

OP_SERVICE_ACCOUNT_TOKEN=$token exec /opt/homebrew/bin/op read "$1"
